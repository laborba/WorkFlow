  "priority": 2,
  "dueDate": null
}


### ProjectTasks - Preparação pausar projeto InProgress - 200
PATCH {{WorkFlow_API_HostAddress}}/api/tenants/{{tenantPrincipalPublicId}}/projects/{{projetoTenantAdminPublicId}}/pause
Authorization: Bearer {{tenantAdminToken}}
Content-Type: application/json
Accept: application/json

{
  "reason": "Preparação para teste de criação de tarefa em projeto pausado."
}


### ProjectTasks - TenantAdmin criar em Paused - 201
POST {{WorkFlow_API_HostAddress}}/api/tenants/{{tenantPrincipalPublicId}}/projects/{{projetoTenantAdminPublicId}}/tasks
Authorization: Bearer {{tenantAdminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Tarefa criada durante pausa",
  "description": "Criação é permitida enquanto o projeto está pausado.",
  "priority": 2,
  "dueDate": null
}


### ProjectTasks - Restaurar projeto Paused para InProgress - 200
PATCH {{WorkFlow_API_HostAddress}}/api/tenants/{{tenantPrincipalPublicId}}/projects/{{projetoTenantAdminPublicId}}/resume
Authorization: Bearer {{tenantAdminToken}}
Content-Type: application/json
Accept: application/json

{
  "newDueDate": null
}


