Authorization: Bearer {{tenantAdminToken}}
Content-Type: application/json
Accept: application/json

{
  "title": "Tarefa para teste de atribuição",
  "description": "Tarefa criada especificamente para validar AssignTask.",
  "priority": 2,
  "dueDate": null
}


